# Configure in the hosting environment; never commit actual keys.
FIELD_SHIFT_DB=/var/lib/field-shift/field_shift.db
FIELD_SHIFT_WARMUP=0
OPENAI_API_KEY=
# Set an accessible Responses API model supporting strict structured outputs.
OPENAI_MODEL=
CIMIS_APP_KEY=
FIELD_SHIFT_AI_DAILY_CALL_LIMIT=50
# Persistent operator-built grids and NASA imagery cache (optional).
# FIELD_SHIFT_LAYER_DIR=/var/lib/field-shift/layers
